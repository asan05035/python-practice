     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[999, 111, 60, 50, 10]\n",
      "[10, 50, 60, 111, 999]\n"
     ]
    }
   ],
   "source": [
    "nums = [50, 60, 10, 999, 111]\n",
    "\n",
    "nums.sort(reverse=True)\n",
    "\n",
    "print(nums)\n",
    "\n",
    "sorted_list = sorted(nums)\n",
    "print(sorted_list)"
   ]
  },
